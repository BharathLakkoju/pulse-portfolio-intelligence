# Pulse — environment variables
# Copy to apps/web/.env and fill in for real deployments.
# In local demo mode, apps/web ships with safe defaults for everything below
# except SESSION_SECRET, which is auto-generated on first run if unset.

# --- Database ---
# Local demo default: SQLite file (see QUESTIONS.md #1 for why this deviates
# from the suggested Postgres/TimescaleDB stack).
DATABASE_URL="file:./prisma/dev.db"

# --- Sessions / auth ---
SESSION_SECRET=                 # random 32+ byte string; auto-generated locally if unset
JWT_SECRET=

# --- Object storage (statement/report uploads) ---
# Local demo default: writes to apps/web/.uploads on local disk instead of S3/MinIO.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_KEY=
OBJECT_STORAGE_SECRET=

# --- Encryption ---
KMS_ENCRYPTION_KEY_ID=          # field-level encryption for tokens/PII (no-op locally, see QUESTIONS.md #9)

# --- Billing (Razorpay) ---
# Left blank in local demo mode -> billing runs in simulated TEST MODE, see QUESTIONS.md #6.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Market data / FX / crypto ---
# Left blank in local demo mode -> synthetic, clearly-labeled demo price series are used
# instead, since PRD requires confirmed commercial display/redistribution rights before
# using any real market data provider in a production path. See QUESTIONS.md #4.
MARKET_DATA_API_KEY=
FX_DATA_API_KEY=
CRYPTO_INDEXER_API_KEY=

BASE_CURRENCY_DEFAULT=INR
